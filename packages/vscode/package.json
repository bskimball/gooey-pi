{
  "name": "apex-vscode",
  "displayName": "Apex",
  "description": "The Apex workspace for Pi, inside VS Code.",
  "version": "0.1.3",
  "publisher": "bdkinc",
  "license": "MIT",
  "private": true,
  "icon": "media/icon-1024.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onUri",
    "onStartupFinished"
  ],
  "scripts": {
    "build:host": "vite build --config vite.host.config.ts && node scripts/copy-browser.mjs",
    "build:webview": "vite build",
    "build": "npm run build:host && npm run build:webview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p webview/tsconfig.json --noEmit",
    "package": "npm run build && node -e \"fs.mkdirSync('../../release', { recursive: true })\" && vsce package --no-dependencies --allow-missing-repository --skip-license --out ../../release"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "apex",
          "title": "Apex",
          "icon": "media/apex.svg"
        }
      ]
    },
    "views": {
      "apex": [
        {
          "type": "webview",
          "id": "apex.chat",
          "name": "Apex"
        }
      ]
    },
    "commands": [
      {
        "command": "apex.open",
        "title": "Open",
        "category": "Apex"
      },
      {
        "command": "apex.newSession",
        "title": "New Session",
        "category": "Apex",
        "icon": "$(add)"
      },
      {
        "command": "apex.stop",
        "title": "Stop",
        "category": "Apex",
        "icon": "$(debug-stop)"
      },
      {
        "command": "apex.restart",
        "title": "Restart Pi",
        "category": "Apex",
        "icon": "$(refresh)"
      },
      {
        "command": "apex.continueInDesktop",
        "title": "Continue in Apex Desktop",
        "category": "Apex"
      },
      {
        "command": "apex.askAboutSelection",
        "title": "Ask About Selection",
        "category": "Apex"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "apex.askAboutSelection",
          "when": "editorHasSelection",
          "group": "navigation@100"
        }
      ],
      "commandPalette": [
        {
          "command": "apex.askAboutSelection",
          "when": "editorHasSelection"
        }
      ],
      "view/title": [
        {
          "command": "apex.newSession",
          "when": "view == apex.chat",
          "group": "navigation@1"
        },
        {
          "command": "apex.restart",
          "when": "view == apex.chat",
          "group": "navigation@2"
        },
        {
          "command": "apex.continueInDesktop",
          "when": "view == apex.chat",
          "group": "1_handoff@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "apex.open",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a"
      }
    ],
    "configuration": {
      "title": "Apex",
      "properties": {
        "apex.piPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the pi executable (pi.cmd on Windows). Leave empty to auto-detect the global npm install."
        },
        "apex.messageEnterAction": {
          "type": "string",
          "enum": [
            "queue",
            "steer"
          ],
          "default": "queue",
          "description": "What Enter does while Pi is working: queue the message for after the turn, or steer the running turn."
        }
      }
    }
  },
  "dependencies": {
    "@xstate/react": "^6.1.0",
    "apex-core": "0.1.0",
    "apex-ui": "*",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "xstate": "^5.33.4"
  },
  "devDependencies": {
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^4.0.0"
  }
}
