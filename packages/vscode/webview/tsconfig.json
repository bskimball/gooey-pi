{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "../../../node_modules/.cache/tsc/vscode-webview.tsbuildinfo",
    "paths": { "@/*": ["../../../apps/desktop/src/*"] },
    "types": ["vite/client", "node"]
  },
  "include": ["./**/*.ts", "./**/*.tsx"]
}
