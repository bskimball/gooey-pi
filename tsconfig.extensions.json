{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsc/extensions.tsbuildinfo",
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["apps/desktop/assets/extensions/**/*.ts"]
}
